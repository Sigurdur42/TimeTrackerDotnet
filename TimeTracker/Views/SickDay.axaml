<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TimeTracker.ViewModels"
        xmlns:converter="clr-namespace:TimeTracker.Views.Converter"
        x:DataType="viewModels:SickDayViewModel"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
        x:Class="TimeTracker.Views.SickDay"
        SizeToContent="WidthAndHeight"
        Title="Sick (half day)">

    <Window.Resources>
        <converter:DateOnlyDateTimeConverter x:Key="DateOnlyDateTimeConverter" />
    </Window.Resources>

    <Grid Margin="5" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Grid.Row="0" Margin="0,3,5,0">Date:</TextBlock>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Grid.Row="1" Margin="0,3,5,0">Credited:</TextBlock>

        <CalendarDatePicker VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Margin="0,3,0,0"
                            MinWidth="150"
                            SelectedDate="{Binding Date, Converter={StaticResource DateOnlyDateTimeConverter}}"
                            SelectedDateFormat="Short" />
        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,0"
                   Text="{Binding Hours, StringFormat='{}{0:0.##} h (half of the target hours)'}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" MaxWidth="300" HorizontalAlignment="Left"
                   Foreground="OrangeRed" TextWrapping="Wrap"
                   IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding Warning}" />

        <Grid Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,10,*" Margin="0,10,0,0">
            <Button Grid.Column="0" Click="OnOk" Classes="Small" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">OK</Button>
            <Button Grid.Column="2" Click="OnCancel" Classes="Small" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">Cancel</Button>
        </Grid>
    </Grid>
</Window>
